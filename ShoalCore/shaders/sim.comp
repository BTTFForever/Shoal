// The body's centre line ("spine"), SPINE_POINTS points per fish from the nose to the tail tip, evenly spaced along the
// fish's length. The head is rigid (points up to SPINE_PIVOT lengths behind the nose sit on the heading); every point
// after that is pulled along behind the one in front at a fixed distance, so the body follows the path the head took,
// like train carriages, and the tail follows the body. fish.vert draws the body along it.
const uint SPINE_POINTS = 10u;
const float SPINE_PIVOT = 0.3; // the simulated position is this far behind the nose, in lengths (as fish.vert's PIVOT)
layout(std430, binding=3) buffer SpineBuf { vec2 Spines[]; };
void updateSpine(Boid b, uint i) {
    uint base = i * SPINE_POINTS;
    vec2 dir = vec2(cos(b.heading), sin(b.heading));
    vec2 nose = b.position + dir * b.fishLength * SPINE_PIVOT;
    float spacing = b.fishLength / float(SPINE_POINTS - 1u);
    vec2 prev = nose;
    Spines[base] = nose;
    for (uint j = 1u; j < SPINE_POINTS; ++j) {
        float x = float(j) / float(SPINE_POINTS - 1u);
        vec2 p;
        if (x <= SPINE_PIVOT) p = nose - dir * (x * b.fishLength);  // rigid head
        else {
            vec2 d = Spines[base + j] - prev;
            float len = length(d);
            // A fresh or broken chain (first frame, or a point left far behind) is laid out straight behind the head.
            if (len < 1e-4 || len > b.fishLength) d = -dir * spacing, len = spacing;
            p = prev + d * (spacing / len);
        }
        Spines[base + j] = p;
        prev = p;
    }
}
