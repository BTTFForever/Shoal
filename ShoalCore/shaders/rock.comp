#version 430
layout(local_size_x = 64) in;
float sat(float x) { return clamp(x, 0.0, 1.0); }
vec2 sat(vec2 x) { return clamp(x, 0.0, 1.0); }
struct Boid { vec2 position; vec2 velocity; float turnRate; float turnTarget; float independentUntil; float nextTurnChange; float heading; float currentSpeed; float stopped; float breakawayHeading; float cruiseSpeed; float yawRate; float swimPhase; float thrust; float fishLength; float depth; };
float swimOmega(float fishSpeed, float fishLength, uint i) { return 6.2831853f * clamp(1.5f * fishSpeed / max(fishLength, 1.0f), 0.8f, 5.0f) * (0.9f + 0.2f * fract(float(i) * 0.61803399f)); }
struct Rock { vec2 position; float radius; float pointCount; float points[12]; };
layout(std140, binding=0) uniform Simulation { float deltaSeconds; float speed; float boidCount; float randomness; float monitorCount; float timeSeconds; float rockCount; float restrictToMonitor; float baseLength; float speedVariability; float colourCount; float colourBias; float colourAvoid; };
float sizeSpeedFactor(float fishLength) { return pow(max(fishLength, 1.0f) / max(baseLength, 1.0f), -0.2f); }
float sizeAccelerationFactor(float fishLength) { return pow(max(fishLength, 1.0f) / max(baseLength, 1.0f), -0.5f); }
bool pointInside(Rock rock, vec2 p) { bool inside = false; for (uint i = 0, j = uint(rock.pointCount) - 1; i < uint(rock.pointCount); j = i++) { vec2 a = rock.position + vec2(rock.points[i * 2], rock.points[i * 2 + 1]); vec2 b = rock.position + vec2(rock.points[j * 2], rock.points[j * 2 + 1]); if ((a.y > p.y) != (b.y > p.y) && p.x < (b.x - a.x) * (p.y - a.y) / (b.y - a.y) + a.x) inside = !inside; } return inside; }
void nearestOnRock(Rock rock, vec2 p, out float distance, out vec2 normal) { distance = 1e9f; vec2 nearest = p; for (uint k = 0; k < uint(rock.pointCount); ++k) { uint q = (k + 1) % uint(rock.pointCount); vec2 a = rock.position + vec2(rock.points[k * 2], rock.points[k * 2 + 1]); vec2 z = rock.position + vec2(rock.points[q * 2], rock.points[q * 2 + 1]); vec2 edge = z - a; float t = sat(dot(p - a, edge) / max(dot(edge, edge), 0.0001f)); vec2 candidate = a + edge * t; float d = length(p - candidate); if (d < distance) { distance = d; nearest = candidate; } } normal = distance > 0.0001f ? (p - nearest) / distance : normalize(p - rock.position + 0.001f); if (pointInside(rock, p)) { normal = -normal; distance = -distance; } }
layout(std430, binding=2) readonly buffer RockBuf { Rock Rocks[]; };
layout(std430, binding=0) buffer BoidBuf { Boid Boids[]; };
// Soft obstacles (negative radius) never push. Fish deep inside a hard one, or inside one and already swimming out, are left to sim.comp.
void main() { uint i = gl_GlobalInvocationID.x; if (i >= boidCount) return; Boid b = Boids[i]; float boidLength = b.fishLength; for (uint r = 0; r < rockCount; ++r) { float distance; vec2 normal; nearestOnRock(Rocks[r], b.position, distance, normal); float along = abs(dot(vec2(cos(b.heading), sin(b.heading)), normal)); float clearance = max(0.5f, boidLength * (0.5f * along + 0.125f * sqrt(sat(1.0f - along * along)))); if (Rocks[r].radius < 0.0f || distance < -boidLength) continue; vec2 heading2 = vec2(cos(b.heading), sin(b.heading)); if (distance < 0.0f && dot(heading2, normal) > 0.2f) continue; if (distance < clearance) { b.position += normal * (clearance - distance); vec2 dir = vec2(cos(b.heading), sin(b.heading)); dir -= normal * min(dot(dir, normal), 0.0f); dir += normal * 0.15f; dir = normalize(dir); b.heading = atan(dir.y, dir.x); b.velocity = dir * b.currentSpeed; b.stopped = 0.0f; break; } } Boids[i] = b; }
