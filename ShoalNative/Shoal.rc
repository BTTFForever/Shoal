#include <winres.h>

// The Screen Saver Settings dialog lists a .scr by string resource 1 (falls back to the file name).
STRINGTABLE
BEGIN
    1 "Shoal"
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Shoal Screensaver"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Shoal"
            VALUE "OriginalFilename", "Shoal.scr"
            VALUE "ProductName", "Shoal"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
